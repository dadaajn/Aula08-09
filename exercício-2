<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exercício 2 - Galeria com iframe</title>
</head>
<body>

    <h1>Índice de Cidades</h1>

    <table>
        <tr>
            <td>
                <a href="https://pt.wikipedia.org/wiki/Paris" target="visor">
                    <img src="paris.jpg" alt="Paris" width="200">
                </a>
            </td>
            <td>
                <a href="https://pt.wikipedia.org/wiki/Londres" target="visor">
                    <img src="londres.jpg" alt="Londres" width="200">
                </a>
            </td>
            <td>
                <a href="https://pt.wikipedia.org/wiki/Roma" target="visor">
                    <img src="roma.jpg" alt="Roma" width="200">
                </a>
            </td>
            <td>
                <a href="https://pt.wikipedia.org/wiki/T%C3%B3quio" target="visor">
                    <img src="toquio.jpg" alt="Tóquio" width="200">
                </a>
            </td>
            <td>
                <a href="https://pt.wikipedia.org/wiki/Nova_Iorque" target="visor">
                    <img src="nova-york.jpg" alt="Nova York" width="200">
                </a>
            </td>
        </tr>
    </table>

    <br>

    <iframe name="visor" width="100%" height="600" title="Visualizador da Wikipedia"></iframe>

</body>
</html>
