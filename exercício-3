<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minhas Cinco Cidades</title>
    <!-- Link para o arquivo CSS do Exercício 3 -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Exercício 3: Uma barra superior de título -->
    <header>
        <h1>Minhas Cinco Cidades</h1>
    </header>

    <div class="container">
        <!-- Exercício 3: O índice em uma barra lateral -->
        <nav class="sidebar">
            <h2>Índice</h2>
            <!-- Exercício 2: O índice deve ser formado por thumbnails em uma tabela -->
            <table>
                <!-- Linha 1: Cidade 1 -->
                <tr>
                    <td>
                        <!-- Exercício 2: Quando o usuário clicar no thumbnail, abre a pág da Wikipédia no iframe -->
                        <a href="https://pt.wikipedia.org/wiki/Paris" target="visor">
                            <img src="paris.jpg" alt="Paris" width="200">
                        </a>
                    </td>
                </tr>
                <!-- Linha 2: Cidade 2 -->
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor">
                            <img src="nova_iorque.jpg" alt="Nova Iorque" width="200">
                        </a>
                    </td>
                </tr>
                <!-- Linha 3: Cidade 3 -->
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor">
                            <img src="toquio.jpg" alt="Tóquio" width="200">
                        </a>
                    </td>
                </tr>
                <!-- Linha 4: Cidade 4 -->
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor">
                            <img src="londres.jpg" alt="Londres" width="200">
                        </a>
                    </td>
                </tr>
                <!-- Linha 5: Cidade 5 -->
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor">
                            <img src="roma.jpg" alt="Roma" width="200">
                        </a>
                    </td>
                </tr>
            </table>
        </nav>

        <!-- Exercício 3: O iframe em um campo à direita do índice -->
        <main class="content">
            <!-- Exercício 2: Inserir um IFrame após o índice (com o name correspondente ao target dos links) -->
            <iframe name="visor" width="800" height="600" src="https://pt.wikipedia.org/wiki/Paris"></iframe>
        </main>
