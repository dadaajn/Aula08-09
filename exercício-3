<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exercício 3 - Layout Semântico</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Barra superior de título -->
    <header>
        <h1>Minhas Cinco Cidades</h1>
    </header>

    <div class="container-layout">
        <!-- Índice em uma barra lateral -->
        <aside>
            <h2>Índice</h2>
            <table>
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor-3">
                            <img src="paris.avif" alt="Paris">
                        </a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor-3">
                            <img src="nova-york.jpg" alt="Nova Iorque">
                        </a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor-3">
                            <img src="toquio.jpg" alt="Tóquio">
                        </a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor-3">
                            <img src="londres.jpeg" alt="Londres">
                        </a>
                    </td>
                </tr>
                <tr>
                    <td>
                        <a href="https://wikipedia.org" target="visor-3">
                            <img src="roma.jpg" alt="Roma">
                        </a>
                    </td>
                </tr>
            </table>
        </aside>

        <!-- Campo à direita do índice -->
        <main>
            <iframe name="visor-3" src="https://wikipedia.org"></iframe>
        </main>
    </div>

</body>
</html>
