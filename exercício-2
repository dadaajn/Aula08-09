<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Exercício 2 - Índice com Thumbnails e Iframe</title>
    <style>
        body { font-family: Arial, sans-serif; max-width: 1050px; margin: 0 auto; padding: 20px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        td { text-align: center; padding: 5px; }
        img { width: 200px; height: auto; display: block; margin: 0 auto; border: 1px solid #ccc; }
        iframe { width: 100%; height: 600px; border: 2px solid #333; margin-top: 10px; }
    </style>
</head>
<body>

    <h1>Minhas Cinco Cidades</h1>

    <!-- Tabela para exibição dos thumbnails em uma única linha -->
    <table>
        <tr>
            <td>
                <a href="https://wikipedia.org" target="visor">
                    <img src="paris.avif" alt="Paris">
                </a>
            </td>
            <td>
                <a href="https://wikipedia.org" target="visor">
                    <img src="nova-york.jpg" alt="Nova Iorque">
                </a>
            </td>
            <td>
                <a href="https://wikipedia.org" target="visor">
                    <img src="toquio.jpg" alt="Tóquio">
                </a>
            </td>
            <td>
                <a href="https://wikipedia.org" target="visor">
                    <img src="londres.jpeg" alt="Londres">
                </a>
            </td>
            <td>
                <a href="https://wikipedia.org" target="visor">
                    <img src="roma.jpg" alt="Roma">
                </a>
            </td>
        </tr>
    </table>

    <!-- IFrame posicionado após o índice -->
    <iframe name="visor" src="https://wikipedia.org"></iframe>

</body>
</html>
